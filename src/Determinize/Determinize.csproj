<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>determinize</ToolCommandName>
    <SignAssembly>false</SignAssembly>
    <RollForward>LatestMajor</RollForward>
    <PackageTags>deterministic, reproducible, pdf, nupkg, docx, xlsx, pptx, cli, dotnet-tool</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CliFx" />
    <PackageReference Include="DeterministicIoPackaging" />
    <PackageReference Include="DeterministicPdf" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Sbom.Targets" PrivateAssets="all" Condition="'$(CI)' == 'true'" />
  </ItemGroup>
</Project>
